---
import FormButton from '../FormButton.astro';

/** Set PUBLIC_FORM_ENDPOINT to your own handler. Without it, submissions
 *  stay in the browser and the form shows its success state. */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const fields = [
  { id: 'first-name', label: '您的称呼 / 昵称', type: 'text', placeholder: '李先生 / Alex', autocomplete: 'given-name' },
  { id: 'work-email', label: '电子邮箱', type: 'email', placeholder: 'your-email@example.com', autocomplete: 'email' },
  { id: 'company', label: '所在团队 / 使用场景', type: 'text', placeholder: '外贸出海 / AI 独立开发 / 个人日常', autocomplete: 'organization' },
];
---
<div class="cform">
  <img class="cform__bg" src="/assets/contact-clouds.webp" alt="" loading="lazy" />
  <form
    class="cform__panel"
    method="post"
    action="#"
    data-demo-form
    data-endpoint={endpoint || undefined}
    data-success-url="/thank-you"
  >
    {fields.map((f) => (
      <div class="cform__field">
        <label class="cform__label" for={f.id}>{f.label}</label>
        <input class="cform__input" id={f.id} name={f.id} type={f.type} placeholder={f.placeholder} autocomplete={f.autocomplete} />
      </div>
    ))}
    <div class="cform__field">
      <label class="cform__label" for="message">咨询或反馈详情</label>
      <textarea class="cform__input cform__input--area" id="message" name="message" rows="4" placeholder="请简述您希望测速的机场品牌、网络疑问或商务诉求…"></textarea>
    </div>
    <FormButton label="发送提交反馈" class="cform__submit" />
  </form>
</div>
