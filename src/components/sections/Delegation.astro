---
import { group, type Feature } from '../../lib/content';
const features = await group<Feature>('features');
---
<section class="delegation" id="delegation">
  <header class="delegation__header">
    <div class="delegation__heading">
      <p class="badge">严苛评测标准</p>
      <h2 class="h2">四大维度真机检验，<br /><em>甄别真正高品质专线机场。</em></h2>
    </div>
    <p class="delegation__lede">
      从晚高峰压力测试、IEPL 物理专线架构甄别，到流媒体与前沿 AI 原生住宅 IP 纯绿解锁，为用户过滤掉线、卡顿与风控隐患。
    </p>
  </header>

  <div class="delegation__inner">
    <ol class="features" role="tablist" aria-label="Delegation features">
      {features.map((f) => (
        <li class="feature" style={`--i:${f.step}`}>
          <button
            class="feature__btn"
            type="button"
            role="tab"
            id={`feature-${f.step}`}
            data-step={f.step}
            aria-selected={f.step === 0 ? 'true' : 'false'}
            aria-controls={`mock-${f.step}`}
            tabindex={f.step === 0 ? 0 : -1}
          >
            <img class="feature__chevron" src="/assets/arrows.svg" alt="" aria-hidden="true" />
            <span class="feature__head">
              <h4 class="feature__label">{f.label}</h4>
              <span class="feature__desc">{f.desc}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>

    <div class="stage">
      {features.map((f) => (
        <div
          class={`mock${f.step === 0 ? ' is-active' : ''}`}
          id={`mock-${f.step}`}
          role="tabpanel"
          aria-labelledby={`feature-${f.step}`}
          data-step={f.step}
          hidden={f.step !== 0}
        >
          <img
            class="mock__img"
            src={f.mock}
            srcset={f.srcset}
            alt=""
            width={f.w}
            height={f.h}
            loading={f.step === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
</section>
