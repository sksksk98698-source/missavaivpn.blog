---
import { group, type IntegrationRow } from '../../lib/content';
const rows = await group<IntegrationRow>('integrationRows');
---
<section class="integrations" id="integrations">
  <header class="integrations__header">
    <p class="badge">全平台多端生态</p>
    <h2 class="h2 h2--center">
      全平台设备覆盖，<em>无缝导入一键连接。</em>
    </h2>
    <p class="integrations__lede">
      全面适配 Windows、macOS、iOS、Android、Linux 及 OpenWrt 软路由。支持 Clash、Shadowrocket、v2rayN、Surge 等全平台客户端一键订阅导入。
    </p>
  </header>

  <div class="int-marquee">
    {rows.map((row) => (
      <div class="int-marquee__row" data-dir={row.dir}>
        {[false, true].map((dup) => (
          <div class="int-marquee__set" aria-hidden={dup ? 'true' : undefined}>
            {row.tiles.map((t) => (
              <span class="int-tile"><img src={t.src} alt={dup ? '' : t.alt} loading="lazy" decoding="async" /></span>
            ))}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
