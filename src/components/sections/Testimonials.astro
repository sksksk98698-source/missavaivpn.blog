---
import { group, type Testimonial } from '../../lib/content';
const testimonials = await group<Testimonial>('testimonials');
---
<section class="testimonials bleed" id="testimonials">
  <header class="testimonials__header">
    <p class="badge">真实用户口碑</p>
    <h2 class="h2">来自跨境外贸、AI 开发者<br /><em>与出海团队的真实实测反馈</em></h2>
    <p class="testimonials__lede">
      从个人独立开发者、高校科研学者到跨境出海电商团队，听听他们在换用 missavaiVPN 评测实验室推荐的物理专线后的体验。
    </p>
  </header>

  <div class="marquee">
    <ul class="marquee__track" id="track" role="list">
      {testimonials.map((t) => (
        <li class="tcard">
          <p class="tcard__quote">{t.quote}</p>
          <figure class="tcard__author">
            <img class="tcard__avatar" src={t.avatar} srcset={t.srcset || undefined} alt="" loading="lazy" decoding="async" />
            <figcaption>
              <h5 class="tcard__name">{t.name}</h5>
              <span class="tcard__role">{t.role}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
