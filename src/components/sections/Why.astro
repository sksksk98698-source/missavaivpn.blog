---
import { group, type Benefit } from '../../lib/content';
const benefits = await group<Benefit>('benefits');
---
<section class="why" id="why">
  <header class="why__header">
    <div class="why__heading">
      <p class="badge">Why MissAvAi VPN</p>
      <h2 class="h2">真实测速与专业评估，<br /><em>拒绝营销话术与滤镜。</em></h2>
    </div>
    <p class="why__lede">
      网络上充斥着大量虚标带宽、晚高峰卡顿乃至动辄跑路的劣质梯子。missavaiVPN 评测实验室坚持晚高峰多宽带实机压测，以客观数据说话，为您的出海业务与日常使用保驾护航。
    </p>
  </header>

  <div class="why-cards" id="why-cards" role="list">
    {benefits.map((b) => (
      <article class={`wcard${b.active ? ' is-active' : ''}`} data-index={b.num} tabindex="0" role="listitem">
        <div class="wcard__closed" aria-hidden="true">
          <p class="wcard__number">{b.num}.</p>
          <div class="wcard__mosaic"><img src={b.mosaic} alt="" loading="lazy" /></div>
          <p class="wcard__title-closed">{b.title}</p>
        </div>
        <div class="wcard__open">
          <div class="wcard__img"><img src={b.image} alt="" width={b.w} height={b.h} loading="lazy" decoding="async" /></div>
          <div class="wcard__content">
            <h3 class="wcard__title">{b.title}</h3>
            <p class="wcard__desc">{b.desc}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
