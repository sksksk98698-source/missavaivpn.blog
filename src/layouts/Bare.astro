---
import Head from './Head.astro';
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource-variable/dm-sans/opsz-italic.css';
import '@fontsource-variable/geist';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  schema?: boolean;
  noindex?: boolean;
}
const { title, description, path, ogImage, schema, noindex } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head title={title} description={description} path={path} ogImage={ogImage} schema={schema} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <slot />
    </main>
    <script>
      import { init as forms } from '../scripts/forms.js';
      forms();
    </script>
  </body>
</html>
