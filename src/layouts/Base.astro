---
import Head from './Head.astro';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import Cta from '../components/sections/Cta.astro';
// High-performance self-hosted fonts
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource-variable/dm-sans/opsz-italic.css';
import '@fontsource-variable/geist';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  schema?: boolean;
  cta?: boolean;
  noindex?: boolean;
  articleMeta?: {
    datePublished: string;
    author: string;
    category: string;
  };
}
const { title, description, path, cta = true, ogImage, schema, noindex, articleMeta } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Head
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      schema={schema}
      noindex={noindex}
      articleMeta={articleMeta}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class="page" data-page={path}>
      <div class="container">
        <slot />
        {cta && <Cta />}
      </div>
      <Footer />
    </main>
    <script>
      import '../scripts/entry.js';
    </script>
  </body>
</html>
