---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RelatedPosts from '../../components/sections/RelatedPosts.astro';
import { dateLabel } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const dateStr = typeof d.date === 'string' ? d.date : new Date(d.date).toISOString().split('T')[0];
const authorOrg = !d.authorOrg ? 'missavaiVPN 评测实验室' : d.authorOrg;
---
<Base
  title={`${d.title} | missavaiVPN 评测实验室`}
  description={d.excerpt || `${d.title} - 查阅 missavaiVPN 评测实验室最新的晚高峰测速跑分、节点配置与出海专线选型指南。`}
  path={`/blog/${post.id}`}
  ogImage={d.ogImage ?? d.cover}
  cta={false}
  articleMeta={{
    datePublished: dateStr,
    author: d.author,
    category: d.category,
  }}
>
  <article class="article">
    <nav class="article__breadcrumbs" aria-label="面包屑导航" style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--grey-600); margin-bottom: 24px;">
      <a href="/" style="color: var(--grey-700); text-decoration: none;">首页</a>
      <span>/</span>
      <a href="/blog" style="color: var(--grey-700); text-decoration: none;">技术专栏</a>
      <span>/</span>
      <span style="color: var(--grey-900); font-weight: 500;">{d.title}</span>
    </nav>

    <header class="article__head">
      <p class="badge">{d.category}</p>
      <h1 class="article__title">{d.title}</h1>
      <p class="article__lede">{d.excerpt}</p>
      <div class="article__author">
        {d.avatar && <img class="article__avatar" src={d.avatar} alt="" width="40" height="40" />}
        <p class="article__name">{d.author}</p>
        <p class="article__role">{authorOrg} <span aria-hidden="true">•</span> {d.authorRole}</p>
      </div>
    </header>

    <img class="article__cover" src={d.cover} alt="" />

    <div class="article__body">
      <Content />
    </div>
  </article>

  <RelatedPosts slug={post.id} category={post.data.category} />
</Base>
