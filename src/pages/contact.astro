---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactMethods from '../components/sections/ContactMethods.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Faq from '../components/sections/Faq.astro';
---
<Base
  title="联系实验室与测速投稿 | missavaiVPN 评测中心"
  description="有新机场希望加入晚高峰测速排期？或对特定节点延迟与流媒体解锁有疑问？欢迎联系 missavaiVPN 评测实验室团队。"
  path="/contact"
>
  <PageHero
    badge="联系评测实验室"
    center
    display
    lede="无论是新机场测速排期申请、测速数据纠错核验，还是跨境网络专线选型咨询，我们的技术团队通常会在数小时内回复。"
  >
    <span class="ts-display--soft">保持沟通 —</span>
    <p slot="after-title" class="ts-display phero__title2">共同维护更真实、更中立的<br />科学上网评测数据库</p>
  </PageHero>

  <section class="contact">
    <ContactMethods />
    <ContactForm />
  </section>

  <Faq />
</Base>
