const canonicalUrl = "https://missavaivpn.blog/scam-warning";

// 结构化数据：Article + FAQPage + BreadcrumbList
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "首页",
