---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import WorkflowGrid from '../components/sections/WorkflowGrid.astro';
import BuildYourOwn from '../components/sections/BuildYourOwn.astro';
import FeaturedComparison from '../components/sections/FeaturedComparison.astro';
import { group, type Stat } from '../lib/content';
const stats = await group<Stat>('workflowStats');

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首页",
      "item": "https://missavaivpn.blog"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "出海场景选型专题中心",
      "item": "https://missavaivpn.blog/workflows"
    }
  ]
};
---
<Base
  title="科学上网选型方案与场景解决方案 | missavaiVPN"
  description="针对跨境电商、出海研发、ChatGPT/Claude AI 生产力与学生党备用等真实场景，missavaiVPN 评测实验室提供端到端选型解决方案。"
  path="/workflows"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <PageHero
    badge="场景解决方案"
    lede="针对跨境外贸、海外研发同步、ChatGPT/Claude 原生 IP 访问及百元内高性价比备用，我们梳理出三套经过晚高峰实测检验的成熟解决方案。"
    stats={stats}
  >科学上网选型<br />专题方案中心</PageHero>

  <div class="wfhero">
    <img src="/assets/wf-hero.webp" alt="missavaiVPN 网络选型架构概览" />
  </div>

  <WorkflowGrid />
  <BuildYourOwn />
  <FeaturedComparison />
</Base>
